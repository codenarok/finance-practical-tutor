# Copy to .env. Generate the secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with a secret shorter than 32 characters.
SECRET_KEY=
DATABASE_URL=postgresql+psycopg2://finuser:finpass@localhost:5432/fintutor
# No Postgres? SQLite works for local runs:
# DATABASE_URL=sqlite:///./dev.db
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
